<Panel id="app_panel" defaultVariant="@id/fullscreenStatusNav" role="@string/default_config" displayId="0">
    <Variant id="@+id/fullscreenNav">
        <Layer layer="@integer/app_panel_layer"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0" />
        <Bounds left="0" top="0" width="100%" height="100%"  bottomOffset="@dimen/nav_bar_height"/>
    </Variant>
    <Variant id="@+id/fullscreenStatusNav">
        <Layer layer="@integer/app_panel_layer"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0" />
        <Bounds left="0" top="0" width="100%" height="100%" bottomOffset="@dimen/nav_bar_height" topOffset="@dimen/status_bar_height"/>
    </Variant>
        <Variant id="@+id/fullscreenStatusNav">
        <Layer layer="@integer/app_panel_layer"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0" />
        <SafeBounds left="0" top="0" width="90%" height="100%" bottomOffset="@dimen/nav_bar_height" topOffset="@dimen/status_bar_height"/>
        <Bounds left="0" top="0" width="100%" height="100%" bottomOffset="@dimen/nav_bar_height" topOffset="@dimen/status_bar_height"/>
    </Variant>
    <Variant id="@+id/fullscreen">
        <Layer layer="@integer/app_panel_layer"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0" />
        <Bounds left="0" top="0" width="100%" height="100%" />
    </Variant>
    <Variant id="@+id/halfScreen">
        <Layer layer="@integer/app_panel_layer"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0" />
        <Bounds left="0" bottom="100%" width="100%" height="50%" bottomOffset="@dimen/nav_bar_height" />
    </Variant>
    <Variant id="@+id/halfScreenSafeBounds">
        <Layer layer="@integer/app_panel_layer"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0" />
        <SafeBounds left="0" bottom="100%" width="100%" height="40%" bottomOffset="@dimen/nav_bar_height" />
        <Bounds left="0" bottom="100%" width="100%" height="50%" bottomOffset="@dimen/nav_bar_height" />
    </Variant>
    <Variant id="@+id/closed">
        <Layer layer="@integer/app_panel_layer"/>
        <Alpha alpha="0.0" />
        <Visibility isVisible="false"/>
        <Bounds left="0" top="@dimen/screen_height" width="100%" height="100%" />
    </Variant>

    <Transitions>
        <Transition onEvent="_Product_FullScreen" toVariant="@id/fullscreen"/>
        <Transition onEvent="_Product_FullScreenWithNavBar"  toVariant="@id/fullscreenNav"/>
        <Transition onEvent="_Product_FullScreenWithSystem"  toVariant="@id/fullscreenStatusNav"/>
        <Transition onEvent="_Product_HalfScreen"  toVariant="@id/halfScreen"/>
        <Transition onEvent="_System_OnHomeEvent" toVariant="@id/closed"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=app_panel" toVariant="@id/fullscreen"/>
    </Transitions>
</Panel>